# Force browsers to revalidate index.html on every visit (still fast --
# results in a cheap 304 if unchanged -- via ETag/Last-Modified) instead of
# blindly reusing a stale cached copy for up to 10 minutes after a deploy.
# Versioned assets (playlist-utils.js?v=..., shows-schedule.js?v=...) don't
# need this since their query string already busts the cache on change.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # The per-day Apple Music link files (enrich/YYYY-MM-DD.json) are
    # rebuilt every few hours for the current day, so they must not inherit
    # the server's 2-day default for JSON. A day's file is reused for 5
    # minutes of browsing, then revalidated (a cheap 304 when unchanged).
    <FilesMatch "^[0-9]{4}-[0-9]{2}-[0-9]{2}\.json$">
        Header set Cache-Control "max-age=300, must-revalidate"
    </FilesMatch>
    # headnod-tracks.json (built daily by scripts/build-headnod-tracklist.js)
    # is a different filename shape, so it does NOT match the rule above and
    # would otherwise inherit the host's 2-day default for JSON. It changes
    # at most once a day, so an hour is plenty fresh; revalidation is a
    # cheap 304 the rest of the time.
    <FilesMatch "^headnod-tracks\.json$">
        Header set Cache-Control "max-age=3600, must-revalidate"
    </FilesMatch>
    # relations.json (built by scripts/build-relations.js, same daily cadence
    # as headnod-tracks.json above) needs the same override — without one it
    # silently inherits the host's 2-day default, so a visitor's browser can
    # serve a relations.json from before that day's update for up to 2 days.
    # This was caught live: right after a run added real relation data,
    # headnod-stats.html's own fetch of this file still returned the old
    # (pre-run) copy from cache.
    <FilesMatch "^relations\.json$">
        Header set Cache-Control "max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# The server gzips HTML and JS on its own but not JSON. A day's link file
# is ~120 KB raw and ~27 KB compressed, and it's fetched on every playlist.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
</IfModule>
